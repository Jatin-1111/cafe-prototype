# Secret used to sign each table's QR code key.
# Without it the app falls back to a public demo secret, which is fine for a
# local walkthrough and not fine for anything a guest can reach.
# Generate one with:  openssl rand -base64 32
TABLE_SECRET=

# MongoDB Atlas connection string. Orders and the sold-out list live here, which
# is what lets a guest's phone and the counter laptop see the same data.
# Atlas > Database > Connect > Drivers, then substitute the database password.
MONGODB_URI=

# Database name within the cluster. Defaults to "refections" if unset.
MONGODB_DB=refections
